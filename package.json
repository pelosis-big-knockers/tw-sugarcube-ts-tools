{
  "name": "tw-sugarcube-ts-tools",
  "displayName": "Twine SugarCube TypeScript Tools",
  "description": "Editor intelligence for SugarCube's setup.* members in TypeScript/JavaScript: completion, go-to-definition, and no false 'property does not exist' errors.",
  "version": "0.1.0",
  "publisher": "pelosis-big-knockers",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "twine",
    "sugarcube",
    "twee",
    "typescript"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "tw-sugarcube-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "scripts": {
    "bundle": "node scripts/bundle-plugin.mjs",
    "postinstall": "node scripts/bundle-plugin.mjs",
    "package": "npm run bundle && vsce package"
  }
}
